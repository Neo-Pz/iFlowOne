{
  "name": "iflow-connect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The iFlow contract: Agent Network ontology, event semantics, transport envelopes, and the runtime-agnostic adapter SDK.",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "snapshots:sync": "node scripts/sync-connect-snapshots.mjs",
    "snapshots:check": "node scripts/sync-connect-snapshots.mjs --check",
    "test:guards:connect": "node scripts/check-connect-guards.mjs",
    "test:guards:ard": "node scripts/check-ard-guards.mjs",
    "test:guards:snapshots": "node scripts/check-snapshot-guards.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.5.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5",
    "tsx": "^4.19.2"
  },
  "license": "Apache-2.0"
}

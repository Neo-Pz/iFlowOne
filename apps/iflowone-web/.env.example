# Which projection source the Web app reads.
#   mock  — replay the golden fixture stream (no DSH needed)
#   edge  — read a local iFlow edge's read API
VITE_IFLOW_SOURCE=mock

# Base URL of the edge, when VITE_IFLOW_SOURCE=edge.
VITE_IFLOW_EDGE_URL=http://127.0.0.1:3080

# Bearer token the edge requires, if it was configured with one.
VITE_IFLOW_EDGE_TOKEN=

# Pace the mock feed instead of loading it all at once (ms per event, 0 = off).
VITE_IFLOW_MOCK_REPLAY_MS=0

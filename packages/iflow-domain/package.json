{
  "name": "iflow-domain",
  "version": "0.3.0",
  "type": "module",
  "description": "iFlow Agent Network ontology: Agent, Goal, Task, Room, Event; state machines, reducers, projectors and read-model contracts.",
  "license": "Apache-2.0",
  "author": "Neo-Pz",
  "homepage": "https://github.com/Neo-Pz/iFlowOne#readme",
  "bugs": {
    "url": "https://github.com/Neo-Pz/iFlowOne/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neo-Pz/iFlowOne.git",
    "directory": "packages/iflow-domain"
  },
  "keywords": [
    "iflow",
    "agent",
    "ontology",
    "event-sourcing",
    "projection",
    "domain"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "iflow-protocol": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.7.2"
  }
}

{
  "name": "iflow-adapter-sdk",
  "version": "0.4.0",
  "type": "module",
  "description": "Runtime-agnostic iFlow edge: origin journal, outbox, command idempotency ledger, local projection and the RuntimePorts contract every host implements.",
  "license": "Apache-2.0",
  "author": "Neo-Pz",
  "homepage": "https://github.com/Neo-Pz/iFlowOne#readme",
  "bugs": {
    "url": "https://github.com/Neo-Pz/iFlowOne/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neo-Pz/iFlowOne.git",
    "directory": "packages/iflow-adapter-sdk"
  },
  "keywords": [
    "iflow",
    "agent",
    "adapter",
    "sdk",
    "event-journal",
    "agent-runtime"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/testing.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "iflow-domain": "workspace:*",
    "iflow-protocol": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.7.2"
  }
}

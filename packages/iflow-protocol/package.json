{
  "name": "iflow-protocol",
  "version": "0.1.0",
  "type": "module",
  "description": "iFlow transport contract: event/command envelopes, canonical serialization, signature ports, version negotiation.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./json-schema": { "import": "./dist/json-schema.js", "types": "./dist/json-schema.d.ts" }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup src/index.ts src/json-schema.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": { "tsup": "^8.5.0", "typescript": "^5.7.2" }
}

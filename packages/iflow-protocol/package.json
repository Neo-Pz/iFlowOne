{
  "name": "iflow-protocol",
  "version": "0.1.1",
  "type": "module",
  "description": "iFlow transport contract: event/command envelopes, canonical serialization, signature ports, version negotiation.",
  "license": "Apache-2.0",
  "author": "Neo-Pz",
  "homepage": "https://github.com/Neo-Pz/iFlowOne#readme",
  "bugs": {
    "url": "https://github.com/Neo-Pz/iFlowOne/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neo-Pz/iFlowOne.git",
    "directory": "packages/iflow-protocol"
  },
  "keywords": [
    "iflow",
    "agent",
    "protocol",
    "event-sourcing",
    "did",
    "signature",
    "a2a"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./json-schema": {
      "import": "./dist/json-schema.js",
      "types": "./dist/json-schema.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/json-schema.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.7.2"
  }
}

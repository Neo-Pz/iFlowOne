{
  "name": "iflow-hub-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Projection-driven iFlow Hub UI. One component set for the DSH-embedded Hub and for iFlowOne Web; it reads view contracts and never a journal.",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
